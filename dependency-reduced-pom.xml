<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>me.mensem</groupId>
  <artifactId>pura-launcher</artifactId>
  <name>Pura Launcher</name>
  <version>1.0.1</version>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <filtering>true</filtering>
        <directory>.</directory>
        <includes>
          <include>version.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>me.mensem.minecraftlauncher.LauncherMain</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>me.mensem.minecraftlauncher.LauncherMain</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId>
        <artifactId>launch4j-maven-plugin</artifactId>
        <version>2.5.3</version>
        <executions>
          <execution>
            <id>pura</id>
            <phase>package</phase>
            <goals>
              <goal>launch4j</goal>
            </goals>
            <configuration>
              <headerType>gui</headerType>
              <icon>${project.basedir}/src/main/resources/web/assets/logo2.ico</icon>
              <jar>${project.build.directory}/${project.artifactId}-${project.version}.jar</jar>
              <outfile>${project.basedir}/Pura.exe</outfile>
              <errTitle>Pura</errTitle>
              <versionInfo>
                <fileVersion>1.0.1.0</fileVersion>
                <txtFileVersion>1.0.1</txtFileVersion>
                <fileDescription>Pura Launcher</fileDescription>
                <copyright>Mensem</copyright>
                <productVersion>1.0.1.0</productVersion>
                <txtProductVersion>1.0.1</txtProductVersion>
                <productName>Pura Launcher</productName>
                <companyName>Mensem</companyName>
                <internalName>Pura</internalName>
                <originalFilename>Pura.exe</originalFilename>
              </versionInfo>
              <jre>
                <minVersion>21.0.0</minVersion>
              </jre>
            </configuration>
          </execution>
          <execution>
            <id>dev</id>
            <phase>package</phase>
            <goals>
              <goal>launch4j</goal>
            </goals>
            <configuration>
              <headerType>gui</headerType>
              <icon>${project.basedir}/src/main/resources/web/assets/logo2.ico</icon>
              <jar>${project.build.directory}/${project.artifactId}-${project.version}.jar</jar>
              <outfile>${project.basedir}/Dev.exe</outfile>
              <errTitle>Dev</errTitle>
              <jre>
                <minVersion>21.0.0</minVersion>
                <opts>
                  <opt>-DPuraDevOffline=true</opt>
                </opts>
              </jre>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.2</javafx.version>
  </properties>
</project>
